#!/usr/bin/env python3
"""Offline CDK CLI stub for the Web Function sandbox lifecycle/smoke tests.

Records invocations and simulates the state a real `cdk deploy`/`cdk destroy`
would create: stack metadata (with ownership tags and outputs), CloudFormation
owned buckets, and app log groups. No AWS calls are made.
"""

import json
import os
import sys

STATE = os.environ["STUB_STATE"]
SANDBOX_ID = os.environ.get("SANDBOX_ID", "")
ACCOUNT = os.environ.get("SANDBOX_ACCOUNT", "")
REGION = os.environ.get("SANDBOX_REGION", "")
NAMESPACE = os.environ.get("SANDBOX_NAMESPACE", "lccdk-wf-sandbox")

OWNER = "LayeredCraft.Cdk.Constructs"
OWNERSHIP_TAG = "lc-webfunction-sandbox-id"
OWNER_TAG = "lc-webfunction-sandbox-owner"

STACKS = os.path.join(STATE, "stacks")
BUCKETS = os.path.join(STATE, "buckets")
LOGS = os.path.join(STATE, "logs")
LOG_META = os.path.join(STATE, "logmeta.json")
for directory in (STACKS, BUCKETS, LOGS):
    os.makedirs(directory, exist_ok=True)

with open(os.path.join(STATE, "calls.log"), "a") as handle:
    handle.write(
        "cdk %s | COMPONENTS=%s SECOND=%s PLACEHOLDER=%s\n"
        % (
            " ".join(sys.argv[1:]),
            os.environ.get("SANDBOX_COMPONENTS", ""),
            os.environ.get("SANDBOX_SECOND_DISTRIBUTION", ""),
            os.environ.get("SANDBOX_ALLOW_PLACEHOLDER_VERSIONS", ""),
        )
    )


def tags():
    return [
        {"Key": OWNERSHIP_TAG, "Value": SANDBOX_ID},
        {"Key": OWNER_TAG, "Value": OWNER},
    ]


def kind_of(name):
    for kind in ("artifacts", "external", "app"):
        if name.endswith("-" + kind):
            return kind
    return "unknown"


def bucket_name(kind):
    return "%s-%s-%s-%s" % (SANDBOX_ID, kind, ACCOUNT, REGION)


def output(key, value):
    return {"OutputKey": key, "OutputValue": value}


def write_stack(name, outputs):
    with open(os.path.join(STACKS, name + ".json"), "w") as handle:
        json.dump({"Tags": tags(), "Outputs": outputs, "Kind": kind_of(name)}, handle)


def endpoint_arn(workload):
    return "arn:aws:lambda:%s:%s:web-function/%s-%s/endpoint/default" % (
        REGION,
        ACCOUNT,
        SANDBOX_ID,
        workload,
    )


def role_arn(name):
    return "arn:aws:iam::%s:role/%s" % (ACCOUNT, name)


# (group name, retentionInDays or None, CloudFormation-owned?) for every log group the app stack
# produces. Mirrors AppStack.cs: Create-mode functions use the default "/aws/lambda/web/{Name}"
# namespace, Use-mode functions use a custom, non-AWS namespace. The ".local" companion of the
# Use-mode-without-companion function is created by Lambda on first request and is never owned by
# CloudFormation, so it survives stack deletion and must be cleaned up by exact name in destroy.sh.
def app_log_groups():
    return [
        ("/aws/lambda/web/%s-nextjs" % SANDBOX_ID, 14, True),
        ("/aws/lambda/web/%s-nextjs.local" % SANDBOX_ID, 3, True),
        ("/aws/lambda/web/%s-aspnetcore" % SANDBOX_ID, 14, True),
        ("/aws/lambda/web/%s-aspnetcore.local" % SANDBOX_ID, 3, True),
        ("/aws/lambda/web/%s-blazor" % SANDBOX_ID, 30, True),
        ("/aws/lambda/web/%s-blazor.local" % SANDBOX_ID, 1, True),
        ("/%s/%s-uselogs" % (NAMESPACE, SANDBOX_ID), 7, True),
        ("/%s/%s-uselogs.local" % (NAMESPACE, SANDBOX_ID), None, False),
        ("/%s/%s-usecompanion" % (NAMESPACE, SANDBOX_ID), 14, True),
        ("/%s/%s-usecompanion.local" % (NAMESPACE, SANDBOX_ID), 3, True),
    ]


def log_group_expectations():
    return [
        {
            "Function": "%s-nextjs" % SANDBOX_ID,
            "Centralized": "/aws/lambda/web/%s-nextjs" % SANDBOX_ID,
            "CentralizedRetentionDays": 14,
            "Companion": "/aws/lambda/web/%s-nextjs.local" % SANDBOX_ID,
            "CompanionRetentionDays": 3,
            "CompanionManaged": True,
        },
        {
            "Function": "%s-aspnetcore" % SANDBOX_ID,
            "Centralized": "/aws/lambda/web/%s-aspnetcore" % SANDBOX_ID,
            "CentralizedRetentionDays": 14,
            "Companion": "/aws/lambda/web/%s-aspnetcore.local" % SANDBOX_ID,
            "CompanionRetentionDays": 3,
            "CompanionManaged": True,
        },
        {
            "Function": "%s-blazor" % SANDBOX_ID,
            "Centralized": "/aws/lambda/web/%s-blazor" % SANDBOX_ID,
            "CentralizedRetentionDays": 30,
            "Companion": "/aws/lambda/web/%s-blazor.local" % SANDBOX_ID,
            "CompanionRetentionDays": 1,
            "CompanionManaged": True,
        },
        {
            "Function": "%s-uselogs" % SANDBOX_ID,
            "Centralized": "/%s/%s-uselogs" % (NAMESPACE, SANDBOX_ID),
            "CentralizedRetentionDays": 7,
            "Companion": "/%s/%s-uselogs.local" % (NAMESPACE, SANDBOX_ID),
            "CompanionRetentionDays": None,
            "CompanionManaged": False,
        },
        {
            "Function": "%s-usecompanion" % SANDBOX_ID,
            "Centralized": "/%s/%s-usecompanion" % (NAMESPACE, SANDBOX_ID),
            "CentralizedRetentionDays": 14,
            "Companion": "/%s/%s-usecompanion.local" % (NAMESPACE, SANDBOX_ID),
            "CompanionRetentionDays": 3,
            "CompanionManaged": True,
        },
    ]


def plant_log_group(name, retention, stored_bytes, events=0):
    path = os.path.join(LOGS, name.lstrip("/"))
    os.makedirs(os.path.dirname(path), exist_ok=True)
    open(path, "a").close()
    meta = {}
    if os.path.exists(LOG_META):
        with open(LOG_META) as handle:
            meta = json.load(handle)
    # "events" is the delivery signal verify-log-groups.sh checks via logs filter-log-events. It is kept
    # separate from storedBytes so the offline suite reproduces real AWS (storedBytes=0 while events exist)
    # and fails if the harness regresses to trusting storedBytes for delivery.
    meta[name] = {"retentionInDays": retention, "storedBytes": stored_bytes, "events": events}
    with open(LOG_META, "w") as handle:
        json.dump(meta, handle)


def remove_log_group(name):
    path = os.path.join(LOGS, name.lstrip("/"))
    if os.path.exists(path):
        os.remove(path)
    if os.path.exists(LOG_META):
        with open(LOG_META) as handle:
            meta = json.load(handle)
        if name in meta:
            del meta[name]
            with open(LOG_META, "w") as handle:
                json.dump(meta, handle)


def app_outputs():
    outputs = [
        output("SandboxId", SANDBOX_ID),
        output("SandboxAccount", ACCOUNT),
        output("SandboxRegion", REGION),
        output("NextJsFunctionName", "%s-nextjs" % SANDBOX_ID),
        output("NextJsDistributionDomain", "127.0.0.1:8443"),
        output("NextJsDistributionId", "EDFDISTNEXTJS"),
        output("NextJsEndpointDomain", "127.0.0.1:8446"),
        output("NextJsEndpointArn", endpoint_arn("nextjs")),
    ]
    if os.environ.get("SANDBOX_SECOND_DISTRIBUTION") == "1":
        outputs.append(output("NextJsSecondDistributionDomain", "127.0.0.1:8445"))
        outputs.append(output("NextJsSecondDistributionId", "EDFDISTNEXTJS2"))
    outputs += [
        output("AspNetCoreFunctionName", "%s-aspnetcore" % SANDBOX_ID),
        output("AspNetCoreEndpointUrl", "https://127.0.0.1:8447"),
        output("AspNetCoreAltEndpointUrl", "https://127.0.0.1:8448"),
        output("AspNetCoreEndpointArn", endpoint_arn("aspnetcore")),
        output("BlazorFunctionName", "%s-blazor" % SANDBOX_ID),
        output("BlazorDistributionDomain", "127.0.0.1:8444"),
        output("BlazorDistributionId", "EDFDISTBLAZOR"),
        output("BlazorEndpointArn", endpoint_arn("blazor")),
        output("UseLogsFunctionName", "%s-uselogs" % SANDBOX_ID),
        output("UseLogsEndpointArn", endpoint_arn("uselogs")),
        output("UseCompanionFunctionName", "%s-usecompanion" % SANDBOX_ID),
        output("UseCompanionEndpointArn", endpoint_arn("usecompanion")),
        output("LogGroupExpectations", json.dumps(log_group_expectations())),
        output("CallerRoleArn", role_arn("%s-caller" % SANDBOX_ID)),
        output("DeniedRoleArn", role_arn("%s-denied" % SANDBOX_ID)),
        output("ImportedCallerImmutableRoleArn", role_arn("%s-imported-caller-immutable" % SANDBOX_ID)),
        output("ImportedCallerMutableRoleArn", role_arn("%s-imported-caller-mutable" % SANDBOX_ID)),
    ]
    return outputs


def deploy(names):
    for name in names:
        kind = kind_of(name)
        if kind in ("artifacts", "external"):
            path = os.path.join(BUCKETS, bucket_name(kind) + ".json")
            if not os.path.exists(path):
                with open(path, "w") as handle:
                    json.dump({"owner": ACCOUNT, "versions": []}, handle)
            write_stack(name, [output("SandboxId", SANDBOX_ID), output("BucketName", bucket_name(kind))])
        elif kind == "app":
            # Every app log group exists after a successful deploy. Managed (CloudFormation-owned) groups
            # are seeded with their configured retention; the Lambda-created ".local" companion is seeded
            # without a retention (no expiry) to mirror the service behaviour it simulates.
            for group_name, retention, _owned in app_log_groups():
                # storedBytes=0 mirrors real AWS (which reported 0 while events existed); events=1 gives the
                # delivery check a real event signal to find after "traffic".
                plant_log_group(group_name, retention, 0, events=1)
            write_stack(name, app_outputs())
        else:
            write_stack(name, [])
    print("stub cdk: deployed %s" % " ".join(names))


def destroy(names):
    for name in names:
        kind = kind_of(name)
        if kind in ("artifacts", "external"):
            path = os.path.join(BUCKETS, bucket_name(kind) + ".json")
            if os.path.exists(path):
                with open(path) as handle:
                    bucket = json.load(handle)
                if bucket.get("versions"):
                    sys.stderr.write("stub cdk: bucket %s is not empty\n" % bucket_name(kind))
                    sys.exit(1)
                os.remove(path)
        elif kind == "app":
            # CloudFormation deletes the log groups it owns together with the stack. The Lambda-created
            # ".local" companion (owned=False) is deliberately left behind: it is not CloudFormation-owned,
            # so destroy.sh must remove it by exact name.
            for group_name, _retention, owned in app_log_groups():
                if owned:
                    remove_log_group(group_name)
        stack = os.path.join(STACKS, name + ".json")
        if os.path.exists(stack):
            os.remove(stack)
    print("stub cdk: destroyed %s" % " ".join(names))


def main():
    args = sys.argv[1:]
    if not args:
        sys.exit(2)
    command = args[0]
    rest = [a for a in args[1:] if not a.startswith("-") and a != "never"]

    if command == "synth":
        sys.exit(0)
    if command == "deploy":
        deploy(rest)
        sys.exit(0)
    if command == "destroy":
        destroy(rest)
        sys.exit(0)
    sys.stderr.write("stub cdk: unsupported command %s\n" % command)
    sys.exit(2)


if __name__ == "__main__":
    main()
